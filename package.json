{
  "name": "generic-annotator",
  "displayName": "Generic Annotator",
  "description": "VS Code extension for linters",
  "icon": "icon.png",
  "author": "Takamasa Oshikiri",
  "license": "MIT",
  "version": "3.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oshikiri/vscode-generic-annotator"
  },
  "publisher": "oshikiri",
  "categories": [
    "Linters"
  ],
  "keywords": [
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "genericAnnotator",
      "properties": {
        "genericAnnotator.annotatorConfigurations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pathRegex",
              "commandTemplate"
            ],
            "additionalProperties": false,
            "properties": {
              "pathRegex": {
                "type": "string",
                "description": "JavaScript regular expression matched against the absolute path of the file to annotate."
              },
              "commandTemplate": {
                "type": "string",
                "description": "Shell command template to run for matching files. ${path} is the quoted absolute file path, and ${workspaceRoot} is the quoted workspace folder path."
              }
            }
          },
          "examples": [
            [
              {
                "pathRegex": "\\.ledger$",
                "commandTemplate": "node ${workspaceRoot}/scripts/regex.js ${path} 'TODO'"
              }
            ]
          ],
          "default": []
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "verify": "npm run format-check && npm run lint && npm run typecheck && npm run test",
    "compile": "tsc -b",
    "package": "vsce package --no-dependencies",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.js\"",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write --list-different .",
    "format-check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "npm run compile && sh ./scripts/e2e.sh"
  },
  "devDependencies": {
    "@jest/globals": "30.0.4",
    "@types/node": "24.0.15",
    "@types/vscode": "1.102.0",
    "@typescript-eslint/parser": "8.37.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "jest": "30.4.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "ts-jest": {
            "tsconfig": "tsconfig.json"
          }
        }
      ]
    },
    "testMatch": [
      "**/unittest/**/*.test.ts"
    ]
  }
}
