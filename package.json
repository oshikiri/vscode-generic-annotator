{
  "name": "generic-annotator",
  "displayName": "Generic Annotator",
  "description": "VS Code extension for linters",
  "icon": "icon.png",
  "author": "Takamasa Oshikiri",
  "license": "MIT",
  "version": "3.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oshikiri/vscode-generic-annotator"
  },
  "publisher": "oshikiri",
  "categories": [
    "Linters"
  ],
  "keywords": [
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "genericAnnotator",
      "properties": {
        "genericAnnotator.annotatorConfigurations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pathRegex": {
                "type": "string",
                "description": ""
              },
              "commandTemplate": {
                "type": "string",
                "description": "command template (${path} will be replace by absolute path of focus file)"
              }
            }
          },
          "default": []
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "verify": "npm run format-check && npm run lint && npm run typecheck && npm run compile && jest",
    "compile": "tsc -b",
    "package": "vsce package --no-dependencies",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.js\"",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write --list-different .",
    "format-check": "prettier --check .",
    "test": "jest && sh ./scripts/e2e.sh"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "30.0.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.0.15",
    "@types/vscode": "1.102.0",
    "@typescript-eslint/parser": "8.37.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "jest": "30.0.4",
    "mocha": "11.7.1",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "ts-jest": {
            "tsconfig": "tsconfig.json"
          }
        }
      ]
    },
    "testMatch": [
      "**/exec.test.ts"
    ]
  }
}
